      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Status Operasional Platform (AIR24)",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB-IoT" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "OFFLINE" }, "1": { "color": "green", "text": "ONLINE" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Timeline Status Perangkat (Online / Offline)",
      "type": "state-timeline",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB-IoT" },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"status\")\n  |> keep(columns: [\"_time\", \"_value\", \"device_id\"])\n  |> aggregateWindow(every: 15s, fn: last, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB-IoT" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Pesan / Menit",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Laju Pesan Telemetri (Message Rate)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB-IoT" },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\")\n  |> group(columns: [\"domain\"])\n  |> aggregateWindow(every: 1m, fn: count, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Telemetri Smart Environment / Air Quality (Tim 3)",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB-IoT" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "CO2 (ppm)",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1000 },
              { "color": "red", "value": 1500 }
            ]
          },
          "unit": "ppm"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "title": "Konsentrasi CO2 (ppm) per Ruangan",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB-IoT" },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\" and r[\"domain\"] == \"air\" and r[\"_field\"] == \"co2_ppm\")\n  |> aggregateWindow(every: 10s, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB-IoT" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "PM2.5 (ug/m3)",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 35 },
              { "color": "red", "value": 75 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "title": "Partikulat PM2.5 (µg/m³) per Ruangan",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB-IoT" },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\" and r[\"domain\"] == \"air\" and r[\"_field\"] == \"pm25_ugm3\")\n  |> aggregateWindow(every: 10s, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    }
  ],
